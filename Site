  <script>
    /*
      PERSONNALISATION DES LIENS
      - Laissez une valeur vide ("") pour afficher le lien comme « bientôt disponible ».
      - Pour email, indiquez uniquement l’adresse, sans « mailto: ».
      - Pour les autres champs, collez une adresse complète commençant par https://
    */
    const SITE_CONFIG = {
      email: "",
      cvUrl: "",
      githubUrl: "",
      researchFolderUrl: "",
      syllabusUrl: "",
      mandateUrl: "",
      scientiaUrl: "",
      ideasUrl: "",
      introEconomicsUrl: "",
      microeconomicsUrl: "",
      openMacroUrl: "",
      quantMethodsUrl: ""
    };

    const panelIds = Array.from(document.querySelectorAll("[data-panel]"), panel => panel.id);
    const navButtons = Array.from(document.querySelectorAll("[data-panel-target]"));
    const mobileSelect = document.getElementById("mobile-section");

    function activatePanel(panelId, updateAddress = true) {
      const targetId = panelIds.includes(panelId) ? panelId : "biographie";

      document.querySelectorAll("[data-panel]").forEach(panel => {
        panel.hidden = panel.id !== targetId;
      });

      navButtons.forEach(button => {
        if (button.dataset.panelTarget === targetId) {
          button.setAttribute("aria-current", "page");
        } else {
          button.removeAttribute("aria-current");
        }
      });

      mobileSelect.value = targetId;

      if (updateAddress) {
        history.replaceState(null, "", `#${targetId}`);
      }

      window.scrollTo({ top: 0, behavior: "smooth" });
    }

    navButtons.forEach(button => {
      button.addEventListener("click", () => activatePanel(button.dataset.panelTarget));
    });

    mobileSelect.addEventListener("change", event => activatePanel(event.target.value));

    window.addEventListener("hashchange", () => {
      activatePanel(window.location.hash.slice(1), false);
    });

    document.querySelectorAll("[data-config-link]").forEach(link => {
      const configKey = link.dataset.configLink;
      const configuredValue = (SITE_CONFIG[configKey] || "").trim();

      if (!configuredValue) {
        link.classList.add("is-disabled");
        link.setAttribute("aria-disabled", "true");
        link.setAttribute("title", "Lien à ajouter dans SITE_CONFIG");
        link.removeAttribute("href");
        return;
      }

      const destination = configKey === "email"
        ? `mailto:${configuredValue}`
        : configuredValue;

      link.setAttribute("href", destination);
      link.classList.remove("is-disabled");
      link.removeAttribute("aria-disabled");
      link.removeAttribute("title");
    });

    document.getElementById("current-year").textContent = new Date().getFullYear();
    activatePanel(window.location.hash.slice(1), false);
  </script>
