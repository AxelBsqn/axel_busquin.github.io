<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Portfolio académique et professionnel d’Axel Busquin, économiste spécialisé en politiques publiques, concurrence, innovation et stratégie des entreprises.">
  <meta name="theme-color" content="#10233f">
  <title>Axel Busquin — Économiste</title>
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%2310233f'/%3E%3Cpath d='M17 45 29 17h6l12 28h-7l-2.5-6H26.2l-2.5 6Zm11.4-12h6.8l-3.4-8.6Z' fill='%23f6b84a'/%3E%3C/svg%3E">

  <!--
    PERSONNALISATION RAPIDE
    1. Descendez tout en bas du fichier et complétez l’objet SITE_CONFIG.
    2. Remplacez ou complétez les textes directement dans les sections ci-dessous.
    3. Pour ajouter une carte, dupliquez simplement un bloc <article class="work-card">.
  -->

  <style>
    :root {
      --navy-950: #081426;
      --navy-900: #10233f;
      --navy-800: #183455;
      --blue-700: #1d4f91;
      --blue-600: #2563a6;
      --blue-100: #e8f0fa;
      --amber-500: #f6b84a;
      --amber-100: #fff3d8;
      --ink: #172337;
      --muted: #647187;
      --line: #dbe3ee;
      --surface: #ffffff;
      --canvas: #f3f6fa;
      --soft: #eef3f8;
      --success: #2e7054;
      --success-soft: #e7f4ed;
      --shadow: 0 18px 45px rgba(18, 42, 74, 0.09);
      --radius-lg: 24px;
      --radius-md: 16px;
      --radius-sm: 11px;
      --sidebar-width: 292px;
    }

    *, *::before, *::after { box-sizing: border-box; }

    html {
      scroll-behavior: smooth;
      background: var(--canvas);
    }

    body {
      margin: 0;
      min-width: 320px;
      min-height: 100vh;
      color: var(--ink);
      background:
        radial-gradient(circle at 88% 4%, rgba(37, 99, 166, 0.10), transparent 30rem),
        var(--canvas);
      font-family: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      font-size: 1rem;
      line-height: 1.65;
      -webkit-font-smoothing: antialiased;
    }

    button, select, a { font: inherit; }
    button { color: inherit; }
    a { color: inherit; }
    img, svg { display: block; max-width: 100%; }

    :focus-visible {
      outline: 3px solid rgba(246, 184, 74, 0.75);
      outline-offset: 3px;
    }

    .skip-link {
      position: fixed;
      top: 12px;
      left: 12px;
      z-index: 100;
      padding: 10px 14px;
      border-radius: 8px;
      color: white;
      background: var(--navy-950);
      transform: translateY(-160%);
      transition: transform 160ms ease;
    }

    .skip-link:focus { transform: translateY(0); }

    .site-shell {
      display: grid;
      grid-template-columns: var(--sidebar-width) minmax(0, 1fr);
      min-height: 100vh;
    }

    .sidebar {
      position: sticky;
      top: 0;
      display: flex;
      flex-direction: column;
      height: 100vh;
      overflow-y: auto;
      padding: 34px 24px 24px;
      color: #eaf0f7;
      background:
        linear-gradient(160deg, rgba(255,255,255,0.055), transparent 38%),
        var(--navy-950);
      border-right: 1px solid rgba(255,255,255,0.08);
    }

    .identity {
      display: flex;
      align-items: center;
      gap: 14px;
      margin: 0 4px 34px;
    }

    .identity-mark {
      display: grid;
      place-items: center;
      width: 48px;
      height: 48px;
      flex: 0 0 48px;
      border: 1px solid rgba(246, 184, 74, 0.65);
      border-radius: 13px;
      color: var(--amber-500);
      background: rgba(255,255,255,0.045);
      font-weight: 760;
      letter-spacing: 0.04em;
    }

    .identity-name {
      margin: 0;
      color: white;
      font-size: 1.02rem;
      font-weight: 720;
      line-height: 1.25;
    }

    .identity-role {
      margin: 3px 0 0;
      color: #9eacc0;
      font-size: 0.8rem;
      line-height: 1.35;
    }

    .nav-label {
      margin: 0 10px 10px;
      color: #71829b;
      font-size: 0.72rem;
      font-weight: 760;
      letter-spacing: 0.13em;
      text-transform: uppercase;
    }

    .section-nav {
      display: grid;
      gap: 6px;
    }

    .nav-item {
      display: grid;
      grid-template-columns: 32px minmax(0, 1fr);
      align-items: center;
      width: 100%;
      min-height: 48px;
      padding: 10px 12px;
      border: 0;
      border-radius: 11px;
      color: #aebbcf;
      background: transparent;
      text-align: left;
      text-decoration: none;
      cursor: pointer;
      transition: color 160ms ease, background 160ms ease, transform 160ms ease;
    }

    .nav-item:hover {
      color: white;
      background: rgba(255,255,255,0.06);
      transform: translateX(2px);
    }

    .nav-item[aria-current="page"] {
      color: white;
      background: rgba(255,255,255,0.095);
      box-shadow: inset 3px 0 0 var(--amber-500);
    }

    .nav-number {
      color: #657792;
      font-size: 0.72rem;
      font-variant-numeric: tabular-nums;
      letter-spacing: 0.05em;
    }

    .nav-item[aria-current="page"] .nav-number { color: var(--amber-500); }

    .sidebar-spacer { flex: 1; min-height: 28px; }

    .sidebar-note {
      margin: 24px 5px 0;
      padding-top: 20px;
      border-top: 1px solid rgba(255,255,255,0.09);
      color: #7f8fa7;
      font-size: 0.76rem;
      line-height: 1.55;
    }

    .sidebar-note strong {
      display: block;
      margin-bottom: 3px;
      color: #c7d1df;
      font-size: 0.78rem;
    }

    .main-area {
      min-width: 0;
      padding: 32px clamp(28px, 5vw, 78px) 42px;
    }

    .mobile-header { display: none; }

    .content-wrap {
      width: min(1120px, 100%);
      margin: 0 auto;
    }

    .topline {
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-height: 42px;
      margin-bottom: 34px;
      color: var(--muted);
      font-size: 0.83rem;
    }

    .topline-title {
      display: flex;
      align-items: center;
      gap: 9px;
      margin: 0;
      font-weight: 650;
    }

    .topline-title::before {
      width: 20px;
      height: 2px;
      content: "";
      background: var(--amber-500);
    }

    .topline-status {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 7px 11px;
      border: 1px solid var(--line);
      border-radius: 999px;
      background: rgba(255,255,255,0.72);
    }

    .topline-status::before {
      width: 7px;
      height: 7px;
      content: "";
      border-radius: 50%;
      background: var(--success);
    }

    .panel { animation: panel-in 280ms ease both; }
    .panel[hidden] { display: none !important; }

    @keyframes panel-in {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .hero {
      position: relative;
      display: grid;
      grid-template-columns: minmax(0, 1.7fr) minmax(210px, 0.62fr);
      gap: clamp(28px, 5vw, 64px);
      align-items: center;
      min-height: 425px;
      overflow: hidden;
      padding: clamp(32px, 5vw, 62px);
      border-radius: var(--radius-lg);
      color: #eff5fb;
      background:
        linear-gradient(125deg, rgba(17,44,76,0.28), transparent 62%),
        var(--navy-900);
      box-shadow: var(--shadow);
    }

    .hero::after {
      position: absolute;
      right: -120px;
      bottom: -160px;
      width: 420px;
      height: 420px;
      content: "";
      border: 1px solid rgba(246,184,74,0.14);
      border-radius: 50%;
      box-shadow: 0 0 0 52px rgba(255,255,255,0.025), 0 0 0 106px rgba(255,255,255,0.018);
      pointer-events: none;
    }

    .hero-copy { position: relative; z-index: 1; }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      margin: 0 0 18px;
      color: var(--blue-700);
      font-size: 0.75rem;
      font-weight: 780;
      letter-spacing: 0.13em;
      text-transform: uppercase;
    }

    .eyebrow::before {
      width: 24px;
      height: 2px;
      content: "";
      background: var(--amber-500);
    }

    .hero .eyebrow { color: #aebed1; }

    .hero h1 {
      max-width: 700px;
      margin: 0;
      color: white;
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(3rem, 7vw, 5.65rem);
      font-weight: 500;
      letter-spacing: -0.055em;
      line-height: 0.95;
    }

    .hero h1 span { color: var(--amber-500); }

    .hero-lead {
      max-width: 710px;
      margin: 27px 0 0;
      color: #c3cfdd;
      font-size: clamp(1rem, 2vw, 1.13rem);
      line-height: 1.75;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 11px;
      margin-top: 30px;
    }

    .action {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 45px;
      padding: 10px 17px;
      border: 1px solid transparent;
      border-radius: 10px;
      font-size: 0.9rem;
      font-weight: 720;
      line-height: 1.2;
      text-decoration: none;
      transition: transform 160ms ease, box-shadow 160ms ease, background 160ms ease;
    }

    .action:hover:not(.is-disabled) {
      transform: translateY(-2px);
      box-shadow: 0 9px 24px rgba(0,0,0,0.16);
    }

    .action-primary {
      color: var(--navy-950);
      background: var(--amber-500);
    }

    .action-secondary {
      color: #eef4fb;
      border-color: rgba(255,255,255,0.22);
      background: rgba(255,255,255,0.055);
    }

    .action-light {
      color: var(--navy-900);
      border-color: var(--line);
      background: white;
    }

    .action-small {
      min-height: 38px;
      padding: 8px 12px;
      font-size: 0.82rem;
    }

    .is-disabled {
      opacity: 0.55;
      cursor: not-allowed;
      pointer-events: none;
    }

    .monogram-wrap {
      position: relative;
      z-index: 1;
      display: grid;
      place-items: center;
      min-height: 250px;
    }

    .monogram {
      display: grid;
      place-items: center;
      width: clamp(160px, 18vw, 220px);
      aspect-ratio: 1;
      border: 1px solid rgba(246,184,74,0.55);
      border-radius: 50%;
      color: var(--amber-500);
      background: rgba(255,255,255,0.035);
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(3.4rem, 7vw, 5.5rem);
      letter-spacing: -0.08em;
      box-shadow: inset 0 0 0 13px rgba(255,255,255,0.025);
    }

    .monogram-caption {
      position: absolute;
      bottom: 5px;
      padding: 7px 11px;
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 999px;
      color: #afbdce;
      background: rgba(8,20,38,0.82);
      font-size: 0.72rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .page-header {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(220px, 0.45fr);
      gap: 32px;
      align-items: end;
      margin: 2px 0 34px;
      padding: 0 2px 28px;
      border-bottom: 1px solid var(--line);
    }

    .page-header h1 {
      margin: 0;
      color: var(--navy-900);
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(2.35rem, 5vw, 4.4rem);
      font-weight: 500;
      letter-spacing: -0.045em;
      line-height: 1.03;
    }

    .page-header p {
      margin: 0 0 4px;
      color: var(--muted);
      font-size: 0.94rem;
      line-height: 1.7;
    }

    .section-block { margin-top: 58px; }

    .section-title-row {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 24px;
      margin-bottom: 20px;
    }

    .section-kicker {
      margin: 0 0 5px;
      color: var(--blue-700);
      font-size: 0.73rem;
      font-weight: 780;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .section-heading {
      margin: 0;
      color: var(--navy-900);
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(1.65rem, 3vw, 2.25rem);
      font-weight: 500;
      letter-spacing: -0.03em;
      line-height: 1.15;
    }

    .section-note {
      max-width: 420px;
      margin: 0;
      color: var(--muted);
      font-size: 0.86rem;
      text-align: right;
    }

    .info-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      gap: 20px;
      margin-top: 22px;
    }

    .card {
      padding: 26px;
      border: 1px solid var(--line);
      border-radius: var(--radius-md);
      background: rgba(255,255,255,0.86);
      box-shadow: 0 10px 28px rgba(25, 49, 78, 0.045);
    }

    .card h2, .card h3 {
      margin: 0;
      color: var(--navy-900);
    }

    .card p { margin: 13px 0 0; color: var(--muted); }

    .statement {
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(1.35rem, 2.4vw, 1.85rem);
      letter-spacing: -0.022em;
      line-height: 1.42;
    }

    .statement em {
      color: var(--blue-700);
      font-style: normal;
    }

    .focus-list {
      display: grid;
      gap: 13px;
      margin: 20px 0 0;
      padding: 0;
      list-style: none;
    }

    .focus-list li {
      display: grid;
      grid-template-columns: 26px minmax(0, 1fr);
      gap: 11px;
      align-items: start;
      color: var(--ink);
      font-size: 0.91rem;
    }

    .focus-list li::before {
      display: grid;
      place-items: center;
      width: 23px;
      height: 23px;
      content: "✓";
      border-radius: 50%;
      color: var(--success);
      background: var(--success-soft);
      font-size: 0.72rem;
      font-weight: 800;
    }

    .topic-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 14px;
    }

    .topic-card {
      min-height: 176px;
      padding: 22px;
      border: 1px solid var(--line);
      border-radius: var(--radius-md);
      background: var(--surface);
    }

    .topic-number {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 34px;
      height: 34px;
      margin-bottom: 25px;
      border-radius: 10px;
      color: var(--blue-700);
      background: var(--blue-100);
      font-size: 0.75rem;
      font-weight: 800;
    }

    .topic-card h3 {
      margin: 0;
      color: var(--navy-900);
      font-size: 0.98rem;
    }

    .topic-card p {
      margin: 8px 0 0;
      color: var(--muted);
      font-size: 0.84rem;
      line-height: 1.55;
    }

    .timeline {
      display: grid;
      margin: 4px 0 0;
      padding: 0;
      list-style: none;
    }

    .timeline-item {
      position: relative;
      display: grid;
      grid-template-columns: minmax(145px, 0.3fr) minmax(0, 1fr);
      gap: 26px;
      padding: 24px 0;
      border-bottom: 1px solid var(--line);
    }

    .timeline-item:last-child { border-bottom: 0; }

    .timeline-meta {
      color: var(--blue-700);
      font-size: 0.77rem;
      font-weight: 760;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .timeline-content h3 {
      margin: 0;
      color: var(--navy-900);
      font-size: 1.03rem;
    }

    .timeline-content p {
      margin: 6px 0 0;
      color: var(--muted);
      font-size: 0.9rem;
    }

    .chip-list {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin: 18px 0 0;
      padding: 0;
      list-style: none;
    }

    .chip {
      padding: 6px 10px;
      border: 1px solid #d7e1ed;
      border-radius: 999px;
      color: #42526a;
      background: #f7f9fc;
      font-size: 0.76rem;
      line-height: 1.2;
    }

    .work-list {
      display: grid;
      gap: 16px;
    }

    .work-card {
      position: relative;
      display: grid;
      grid-template-columns: 120px minmax(0, 1fr) auto;
      gap: 24px;
      align-items: start;
      padding: 26px;
      overflow: hidden;
      border: 1px solid var(--line);
      border-radius: var(--radius-md);
      background: var(--surface);
      box-shadow: 0 9px 28px rgba(25, 49, 78, 0.035);
    }

    .work-card::before {
      position: absolute;
      top: 0;
      bottom: 0;
      left: 0;
      width: 4px;
      content: "";
      background: var(--blue-600);
    }

    .work-type {
      color: var(--blue-700);
      font-size: 0.73rem;
      font-weight: 780;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .work-year {
      display: block;
      margin-top: 5px;
      color: #8b97a9;
      font-size: 0.8rem;
      font-weight: 560;
      letter-spacing: 0;
      text-transform: none;
    }

    .work-content h2, .work-content h3 {
      margin: 0;
      color: var(--navy-900);
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(1.25rem, 2.4vw, 1.65rem);
      font-weight: 500;
      letter-spacing: -0.022em;
      line-height: 1.28;
    }

    .work-content p {
      max-width: 740px;
      margin: 12px 0 0;
      color: var(--muted);
      font-size: 0.9rem;
      line-height: 1.66;
    }

    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      white-space: nowrap;
      padding: 6px 9px;
      border-radius: 999px;
      color: var(--success);
      background: var(--success-soft);
      font-size: 0.71rem;
      font-weight: 760;
    }

    .status-badge::before {
      width: 6px;
      height: 6px;
      content: "";
      border-radius: 50%;
      background: currentColor;
    }

    .status-badge.is-finished {
      color: var(--blue-700);
      background: var(--blue-100);
    }

    .project-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }

    .project-card {
      display: flex;
      flex-direction: column;
      min-height: 285px;
      padding: 27px;
      border: 1px solid var(--line);
      border-radius: var(--radius-md);
      background: var(--surface);
      transition: border-color 160ms ease, transform 160ms ease, box-shadow 160ms ease;
    }

    .project-card:hover {
      border-color: #bfcddd;
      transform: translateY(-3px);
      box-shadow: var(--shadow);
    }

    .project-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
    }

    .project-code {
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      border-radius: 12px;
      color: var(--amber-500);
      background: var(--navy-900);
      font-family: Georgia, "Times New Roman", serif;
      font-size: 0.9rem;
      font-weight: 700;
    }

    .project-card h2, .project-card h3 {
      margin: 24px 0 0;
      color: var(--navy-900);
      font-family: Georgia, "Times New Roman", serif;
      font-size: 1.5rem;
      font-weight: 500;
      letter-spacing: -0.025em;
      line-height: 1.25;
    }

    .project-card p {
      margin: 12px 0 22px;
      color: var(--muted);
      font-size: 0.89rem;
      line-height: 1.65;
    }

    .project-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-top: auto;
      padding-top: 17px;
      border-top: 1px solid var(--line);
    }

    .project-footer span {
      color: #7b889b;
      font-size: 0.76rem;
    }

    .text-link {
      color: var(--blue-700);
      font-size: 0.81rem;
      font-weight: 720;
      text-decoration: none;
    }

    .text-link:hover:not(.is-disabled) { text-decoration: underline; }

    .teaching-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }

    .teaching-card {
      display: grid;
      grid-template-columns: 58px minmax(0, 1fr);
      gap: 19px;
      padding: 24px;
      border: 1px solid var(--line);
      border-radius: var(--radius-md);
      background: var(--surface);
    }

    .teaching-icon {
      display: grid;
      place-items: center;
      width: 58px;
      height: 58px;
      border-radius: 15px;
      color: var(--navy-900);
      background: var(--amber-100);
      font-family: Georgia, "Times New Roman", serif;
      font-size: 1.03rem;
      font-weight: 700;
    }

    .teaching-content h2, .teaching-content h3 {
      margin: 0;
      color: var(--navy-900);
      font-size: 1rem;
    }

    .teaching-content p {
      margin: 7px 0 13px;
      color: var(--muted);
      font-size: 0.84rem;
      line-height: 1.55;
    }

    .resource-columns {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 16px;
    }

    .resource-group {
